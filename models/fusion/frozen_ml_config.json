      "reliability_raw_score": "max(0, validation_macro_f1) + epsilon",
      "epsilon": 0.05,
      "entropy": "H(p) = -sum_c p_c * ln(max(p_c, 1e-15)); zero-probability terms contribute 0",
      "normalized_entropy": "H(p) / ln(4)",
      "certainty": "clip(1 - normalized_entropy, 0, 1)",
      "gate": "epsilon + certainty",
      "unnormalized_trial_weight": "reliability_prior_weight * gate",
      "per_trial_weight": "unnormalized_trial_weight / sum_model(unnormalized_trial_weight)",
      "fused_probability": "sum_model(per_trial_weight * trial_probability), followed by sum normalization",
